                "time-series",
                "create"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"queue_name\": \"val-tzok-{{$timestamp}}\",\n  \"config\": {\n    \"aggregation_fields\": [\n      \"v\"\n    ],\n    \"timezone\": \"America/New_York\"\n  },\n  \"description\": \"ok tz\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200/201\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "pm.test(\"Response has queue_id\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"queue_id\");",
                  "});"
                ]
              }
            }
