    {
      "name": "Feedback via API (client credentials)",
      "item": [
        {
          "name": "Create Client \u2014 Feedback API",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{tenant_exp_url}}/clients",
              "host": [
                "{{tenant_exp_url}}"
              ],
              "path": [
                "clients"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_name\": \"feedback-api-{{$timestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200/201\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "pm.test(\"Response has client_id\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"client_id\");",
                  "});",
                  "",
                  "// --- capture ---",
                  "var json = pm.response.json();",
                  "if (json.client_id) { pm.collectionVariables.set('fb_id', json.client_id); }",
                  "if (json.client_secret) { pm.collectionVariables.set('fb_secret', json.client_secret); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login \u2014 Feedback Client",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{tenant_exp_url}}/clients/auth",
              "host": [
                "{{tenant_exp_url}}"
              ],
              "path": [
                "clients",
                "auth"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_id\": \"{{fb_id}}\",\n  \"client_secret\": \"{{fb_secret}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200]);",
                  "});",
                  "pm.test(\"Response has access_token\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"access_token\");",
                  "});",
                  "",
                  "// --- capture ---",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('fb_token', json.access_token);"
                ]
              }
            }
          ]
        },
