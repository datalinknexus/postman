            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"bug\",\n  \"subject\": \"Consume returns 500 intermittently\",\n  \"message\": \"Roughly every 10th consume on a queue 500s; correlation id is in the headers.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
