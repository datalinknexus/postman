{
  "info": {
    "name": "Tenant EXP \u2014 feedback",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Login \u2014 Tenant User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{tenant_exp_url}}/auth/login",
              "host": [
                "{{tenant_exp_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200]);",
                  "});",
                  "pm.test(\"Response has access_token\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"access_token\");",
                  "});",
                  "",
                  "// --- capture ---",
                  "var json = pm.response.json();",
                  "pm.environment.set('user_token', json.access_token);",
                  "if (json.refresh_token) { pm.collectionVariables.set('user_refresh_token', json.refresh_token); }"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Feedback (portal user)",
      "item": [
        {
          "name": "File a bug (user JWT)",
          "request": {
            "method": "POST",
