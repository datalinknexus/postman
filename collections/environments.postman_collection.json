{
  "info": {
    "name": "Tenant EXP \u2014 environments",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Login \u2014 Tenant User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{tenant_exp_url}}/auth/login",
              "host": [
                "{{tenant_exp_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200]);",
                  "});",
                  "pm.test(\"Response has access_token\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"access_token\");",
                  "});",
                  "",
                  "// --- capture ---",
                  "var json = pm.response.json();",
                  "pm.environment.set('user_token', json.access_token);",
                  "if (json.refresh_token) { pm.collectionVariables.set('user_refresh_token', json.refresh_token); }"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Environment self-service",
      "item": [
        {
          "name": "Environment status (owner)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{tenant_exp_url}}/environments",
              "host": [
                "{{tenant_exp_url}}"
              ],
              "path": [
                "environments"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200]);",
                  "});",
                  "pm.test(\"Response has configured\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"configured\");",
                  "});",
                  "pm.test(\"Response has eligible\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"eligible\");",
                  "});",
                  "pm.test(\"Response has requestable\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"requestable\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Request TEST env \u2014 refused for a trial tenant (402)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{tenant_exp_url}}/environments/request",
              "host": [
                "{{tenant_exp_url}}"
              ],
              "path": [
                "environments",
                "request"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"environment\": \"test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 402\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([402]);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "tenant_exp_url",
      "value": ""
    },
    {
      "key": "user_email",
      "value": ""
    },
    {
      "key": "user_password",
      "value": ""
    },
    {
      "key": "queue_id",
      "value": ""
    }
  ]
}