{
  "info": {
    "name": "Tenant EXP \u2014 storage quota",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "01 Login \u2014 Tenant User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{tenant_exp_url}}/auth/login",
              "host": [
                "{{tenant_exp_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200]);",
                  "});",
                  "pm.test(\"Response has access_token\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"access_token\");",
                  "});",
                  "",
                  "// --- capture ---",
                  "var json = pm.response.json();",
                  "pm.environment.set('user_token', json.access_token);",
                  "if (json.refresh_token) { pm.collectionVariables.set('user_refresh_token', json.refresh_token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Create Queue (one-to-one)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{tenant_exp_url}}/queues/one-to-one/create",
              "host": [
                "{{tenant_exp_url}}"
              ],
              "path": [
                "queues",
                "one-to-one",
                "create"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"queue_name\": \"scenario-quota-{{$timestamp}}\",\n  \"config\": {\n    \"max_queue_depth\": 10000,\n    \"max_message_age_seconds\": 3600\n  },\n  \"description\": \"one-to-one scenario queue\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200/201\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "pm.test(\"Response has queue_id\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"queue_id\");",
                  "});",
                  "",
                  "// --- capture ---",
                  "var json = pm.response.json();",
                  "if (json.queue_id) { pm.collectionVariables.set('queue_id', json.queue_id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Get queue settings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{tenant_exp_url}}/queues/list",
              "host": [
                "{{tenant_exp_url}}"
              ],
              "path": [
                "queues",
                "list"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200]);",
                  "});",
                  "pm.test(\"Response has queues\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"queues\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Create Client \u2014 Quota",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{tenant_exp_url}}/clients",
              "host": [
                "{{tenant_exp_url}}"
              ],
              "path": [
                "clients"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_name\": \"quota-client-{{$timestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200/201\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "pm.test(\"Response has client_id\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"client_id\");",
                  "});",
                  "",
                  "// --- capture ---",
                  "var json = pm.response.json();",
                  "if (json.client_id) { pm.collectionVariables.set('quota_id', json.client_id); }",
                  "if (json.client_secret) { pm.collectionVariables.set('quota_secret', json.client_secret); }"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Grant Quota Permission",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{tenant_exp_url}}/clients/{{quota_id}}/queue-permissions/{{queue_id}}",
              "host": [
                "{{tenant_exp_url}}"
              ],
              "path": [
                "clients",
                "{{quota_id}}",
                "queue-permissions",
                "{{queue_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"can_publish\": true,\n  \"can_consume\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200/204\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Login \u2014 Quota Client",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{tenant_exp_url}}/clients/auth",
              "host": [
                "{{tenant_exp_url}}"
              ],
              "path": [
                "clients",
                "auth"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_id\": \"{{quota_id}}\",\n  \"client_secret\": \"{{quota_secret}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200]);",
                  "});",
                  "pm.test(\"Response has access_token\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"access_token\");",
                  "});",
                  "",
                  "// --- capture ---",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('quota_token', json.access_token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "06 Storage quota (usage read + shrink never blocked)",
      "item": [
        {
          "name": "06.01 Storage usage read (tenant-only)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{tenant_exp_url}}/storage/usage",
              "host": [
                "{{tenant_exp_url}}"
              ],
              "path": [
                "storage",
                "usage"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200]);",
                  "});",
                  "pm.test(\"Response has bytes\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"bytes\");",
                  "});",
                  "pm.test(\"Response has max_bytes\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"max_bytes\");",
                  "});",
                  "pm.test(\"Response has queues\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"queues\");",
                  "});",
                  "pm.test(\"Response has max_queues\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"max_queues\");",
                  "});",
                  "pm.test(\"Response has clients\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"clients\");",
                  "});",
                  "pm.test(\"Response has max_clients\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"max_clients\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "06.02 Client CANNOT read storage usage (tenant-only, 403)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{quota_token}}"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{tenant_exp_url}}/storage/usage",
              "host": [
                "{{tenant_exp_url}}"
              ],
              "path": [
                "storage",
                "usage"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 403\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([403]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "06.03 Publish message (200 under cap, or 507 at cap)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{quota_token}}"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{tenant_exp_url}}/queues/{{queue_id}}/publish",
              "host": [
                "{{tenant_exp_url}}"
              ],
              "path": [
                "queues",
                "{{queue_id}}",
                "publish"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payload\": {\n    \"order_id\": \"QUOTA-1\",\n    \"amount\": 1\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200/202/507\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 202, 507]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "06.04 Consume (never blocked by quota)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{quota_token}}"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{tenant_exp_url}}/queues/{{queue_id}}/consume",
              "host": [
                "{{tenant_exp_url}}"
              ],
              "path": [
                "queues",
                "{{queue_id}}",
                "consume"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200/204\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                  "});",
                  "",
                  "// --- capture ---",
                  "var json = pm.response.json();",
                  "var messageId = pm.response.headers.get('X-Message-Id') || json.message_id;",
                  "var leaseId = pm.response.headers.get('X-Lease-Id') || json.lease_id;",
                  "if (messageId) { pm.collectionVariables.set('message_id', messageId); }",
                  "if (leaseId) { pm.collectionVariables.set('lease_id', leaseId); }"
                ]
              }
            }
          ]
        },
        {
          "name": "06.05 Ack (never blocked by quota; frees bytes)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{quota_token}}"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{tenant_exp_url}}/queues/{{queue_id}}/ack",
              "host": [
                "{{tenant_exp_url}}"
              ],
              "path": [
                "queues",
                "{{queue_id}}",
                "ack"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message_id\": \"{{message_id}}\",\n  \"lease_id\": \"{{lease_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200]);",
                  "});",
                  "pm.test(\"status == ok\", function () {",
                  "    pm.expect(pm.response.json().status).to.eql(\"ok\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "tenant_exp_url",
      "value": ""
    },
    {
      "key": "user_email",
      "value": ""
    },
    {
      "key": "user_password",
      "value": ""
    },
    {
      "key": "queue_id",
      "value": ""
    }
  ]
}