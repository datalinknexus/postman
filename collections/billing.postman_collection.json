                ]
              }
            }
          ]
        },
        {
          "name": "04 Grant Biller Permission",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{tenant_exp_url}}/clients/{{biller_id}}/queue-permissions/{{queue_id}}",
              "host": [
                "{{tenant_exp_url}}"
              ],
              "path": [
                "clients",
                "{{biller_id}}",
                "queue-permissions",
                "{{queue_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"can_publish\": true,\n  \"can_consume\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200/204\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Login \u2014 Biller Client",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
