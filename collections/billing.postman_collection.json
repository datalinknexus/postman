                "{{tenant_exp_url}}"
              ],
              "path": [
                "billing"
              ],
              "query": [
                {
                  "key": "year",
                  "value": "{{bill_year}}"
                },
                {
                  "key": "month",
                  "value": "{{bill_month}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200]);",
                  "});",
                  "pm.test(\"Response has published_count\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"published_count\");",
                  "});",
                  "pm.test(\"Response has consumed_count\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"consumed_count\");",
                  "});",
                  "pm.test(\"Response has total_messages\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"total_messages\");",
                  "});",
                  "",
                  "// --- capture ---",
                  "pm.test('usage only: no billing settings', function () {",
                  "    pm.expect(pm.response.json()).to.not.have.property('settings');",
                  "});",
                  "pm.test('usage only: no priced total_amount', function () {",
                  "    pm.expect(pm.response.json()).to.not.have.property('total_amount');",
                  "});",
                  "pm.test('published_count reflects the publishes (>= 3)', function () {",
                  "    pm.expect(pm.response.json().published_count).to.be.at.least(3);",
                  "});",
                  "pm.test('consumed_count reflects the consumes (>= 3)', function () {",
                  "    pm.expect(pm.response.json().consumed_count).to.be.at.least(3);",
                  "});",
                  "pm.test('total_messages is numeric', function () {",
                  "    pm.expect(pm.response.json().total_messages).to.be.a('number');",
                  "});"
                ]
              }
            }
          ]
        }
