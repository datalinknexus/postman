{
  "info": {
    "name": "Tenant EXP \u2014 billing",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "01 Login \u2014 Tenant User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{tenant_exp_url}}/auth/login",
              "host": [
                "{{tenant_exp_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200]);",
                  "});",
                  "pm.test(\"Response has access_token\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"access_token\");",
                  "});",
                  "",
                  "// --- capture ---",
                  "var json = pm.response.json();",
                  "pm.environment.set('user_token', json.access_token);",
                  "if (json.refresh_token) { pm.collectionVariables.set('user_refresh_token', json.refresh_token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Create Queue (one-to-one)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{tenant_exp_url}}/queues/one-to-one/create",
              "host": [
                "{{tenant_exp_url}}"
              ],
              "path": [
                "queues",
                "one-to-one",
                "create"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"queue_name\": \"scenario-billing-{{$timestamp}}\",\n  \"config\": {\n    \"max_queue_depth\": 10000,\n    \"max_message_age_seconds\": 3600\n  },\n  \"description\": \"one-to-one scenario queue\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200/201\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "pm.test(\"Response has queue_id\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"queue_id\");",
                  "});",
                  "",
                  "// --- capture ---",
                  "var json = pm.response.json();",
                  "if (json.queue_id) { pm.collectionVariables.set('queue_id', json.queue_id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Get queue settings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{tenant_exp_url}}/queues/list",
