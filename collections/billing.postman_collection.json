    {
      "name": "06 Usage read (tenant-only, counts only)",
      "item": [
        {
          "name": "06.01 Client CANNOT read billing (tenant-only, 403)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{biller_token}}"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{tenant_exp_url}}/billing?year={{bill_year}}&month={{bill_month}}",
              "host": [
                "{{tenant_exp_url}}"
              ],
              "path": [
                "billing"
              ],
              "query": [
                {
                  "key": "year",
                  "value": "{{bill_year}}"
                },
                {
                  "key": "month",
                  "value": "{{bill_month}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var now = new Date();",
                  "pm.collectionVariables.set('bill_year', now.getUTCFullYear());",
                  "pm.collectionVariables.set('bill_month', now.getUTCMonth() + 1);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 403\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([403]);",
                  "});",
                  "pm.test(\"error names client tokens\", function () {",
                  "    pm.expect(JSON.stringify(pm.response.json())).to.match(/client token/i);",
                  "});"
                ]
              }
            }
          ]
        },
